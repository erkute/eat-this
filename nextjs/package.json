{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -r public/. .next/standalone/public/",
    "build:isolated": "NEXT_DIST_DIR=.next-verify next build && cp -r public/. .next-verify/standalone/public/",
    "build:basemap": "tsx scripts/build-basemap-style.mts && tsx scripts/build-basemap-style.mts --dark",
    "build:transit-stations": "tsx scripts/build-transit-stations.mts",
    "build:email-art": "tsx scripts/build-email-art.mts",
    "build:email-spots": "tsx scripts/build-email-spots.mts",
    "build:deck-og-art": "tsx scripts/build-deck-og-art.mts",
    "build:cover-cutouts": "tsx scripts/build-cover-cutouts.mts",
    "sync:analytics-bot-ips": "tsx scripts/sync-analytics-bot-ips.mts",
    "sync:brand-font": "tsx scripts/sync-brand-font.mts",
    "start": "next start",
    "import:restaurant": "tsx scripts/import-enriched.ts",
    "import:batch": "tsx scripts/import-batch.ts",
    "embed:restaurants": "tsx scripts/embed-restaurants.ts",
    "embed:articles": "tsx scripts/embed-articles.ts",
    "search:terms": "tsx scripts/build-search-terms.ts",
    "content:backlog": "tsx scripts/content-backlog.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.verify.json",
    "lint:content": "tsx scripts/content-lint.ts",
    "audit:css-modules": "tsx scripts/audit-css-modules.ts",
    "check:embeddings": "tsx scripts/check-embeddings.ts",
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools@14.22.0 emulators:exec --only firestore,storage --project eat-this-rules-test \"vitest run __tests__/firestore.rules.test.ts __tests__/storage.rules.test.ts __tests__/app/api/referral-confirm.integration.test.ts\"",
    "test:watch": "vitest",
    "start:verify": "NEXT_DIST_DIR=.next-verify next start --hostname 127.0.0.1 --port 3100",
    "test:e2e": "playwright test",
    "audit:preview": "npx --yes @lhci/cli@0.15.1 autorun --config=../lighthouserc.preview.cjs",
    "audit:field": "tsx scripts/audit-field-vitals.mts",
    "build:brand-icons": "tsx scripts/build-brand-icons.mts",
    "build:brand-cards": "tsx scripts/build-brand-cards.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@google-cloud/firestore": "^7.11.6",
    "@gsap/react": "^2.1.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@sanity/client": "^7.28.0",
    "@sentry/nextjs": "^10.78.0",
    "dotenv": "^17.4.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.43.0",
    "google-auth-library": "^10.9.1",
    "gsap": "^3.15.1",
    "maplibre-gl": "^6.19.0",
    "next": "15.5.29",
    "next-intl": "^4.15.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-map-gl": "^8.1.3",
    "resend": "^6.38.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^17.7.0"
  },
  "optionalDependencies": {
    "@parcel/watcher-linux-x64-glibc": "2.5.6",
    "@rolldown/binding-darwin-arm64": "^1.1.4",
    "@rolldown/binding-linux-x64-gnu": "^1.0.0-rc.16",
    "@swc/core-linux-x64-gnu": "1.16.22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.33",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.26"
    },
    "sharp": "^0.35.5",
    "uuid": "^11.1.1",
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    },
    "@sentry/bundler-plugins": {
      "glob": "^14.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
