{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(* --no-verify*)",
      "mcp__firebase__firestore_delete_database",
      "mcp__firebase__firestore_delete_backup",
      "mcp__firebase__firebase_create_project"
    ]
  },
  "enabledMcpjsonServers": [
    "firebase"
  ]
}
