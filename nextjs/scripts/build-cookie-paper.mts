import { writeFile } from 'node:fs/promises';
import sharp from 'sharp';

// The decorative consent paper ships with its CSS, ready for the first paint.
const paper = await sharp('public/pics/paper/folded-white.webp')
  .resize({ width: 1080 })
  .webp({ quality: 80 })
  .toBuffer();
await writeFile('app/components/CookiePaper.generated.module.css',
  `/* Generated by npm run build:cookie-paper. */\n.paper {\n  background-image: url("data:image/webp;base64,${paper.toString('base64')}");\n}\n`);
console.log(`Cookie paper: ${paper.byteLength} bytes embedded in CSS.`);
