.DS_Store
node_modules/
.env
.env.local
*.log

# Build artifacts & caches
.firebase/
.agents/
# `.claude/*` and not `.claude/` — git does not descend into an excluded
# DIRECTORY, so a `!.claude/launch.json` negation under `.claude/` would be
# silently ignored. That is also why the skills path below re-includes one
# level at a time instead of naming the file directly: `!.../SKILL.md` alone
# would never be reached, because `.claude/skills` is still excluded.
#
# Shared, because it is project knowledge rather than machine state:
#   launch.json          — how to run this app
#   settings.json        — the permission allowlist (tests, lint, typecheck,
#                          build, push, PR tools), so a fresh remote session
#                          stops asking for every one of them (Betreiber,
#                          07.09.2026). Merging stays a prompt on purpose.
#                          Machine-specific overrides go to settings.local.json.
#   skills/deploy-verify — how to tell a finished App Hosting rollout from the
#                          CDN edge cache lying about it
# Still local: settings.local.json, hooks/, agents/, worktrees/, .DS_Store.
.claude/*
!.claude/launch.json
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/deploy-verify/
!.claude/commands/
.claude/commands/*
!.claude/commands/pre-merge-review.md
.codex/
.mcp.json
.playwright-mcp/
.worktrees/
.superpowers/
test-results/
.qa-tmp/
.private/
studio/.sanity/

# Workflow screenshots from browser sessions — stay local
/peek-*.png
/handle-*.png
/mobile-scroll-*.png
/.home-*.png
/.s[0-9]*.png

# Rive working assets (PNG/.riv source) — not shipped
rive-src/

# Kartenbilder der Premium-Must-Eats — Eingabeordner für
# scripts/replace-must-eat-cards.ts (--cards ../CARDS). Die Karten selbst sind
# Produktionsdaten in Firestore + Cloud Storage, kein Deploy-Artefakt.
/CARDS/

# Lizenzierte Desktop-Schrift — nur lokal, aus ihr entstehen die E-Mail-PNGs
# (npm run sync:brand-font). Die Schrift selbst gehört nicht ins Repo.
nextjs/assets/fonts/Providence*
