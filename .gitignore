.DS_Store
node_modules/
.env
.env.local
*.log

# Build artifacts & caches
.firebase/
.agents/
# `.claude/*` and not `.claude/` — git does not descend into an excluded
# DIRECTORY, so a `!.claude/launch.json` negation under `.claude/` would be
# silently ignored. Everything in there stays out (settings, hooks, agents,
# skills, worktrees, .DS_Store); only the dev-server launch config is shared,
# because it is project knowledge — how to run this app — not machine state.
.claude/*
!.claude/launch.json
.codex/
.mcp.json
.playwright-mcp/
.worktrees/
.superpowers/
test-results/
.qa-tmp/
.private/
studio/.sanity/

# Workflow screenshots from browser sessions — stay local
/peek-*.png
/handle-*.png
/mobile-scroll-*.png
/.home-*.png
/.s[0-9]*.png

# Rive working assets (PNG/.riv source) — not shipped
rive-src/
